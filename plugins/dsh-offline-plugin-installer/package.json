{
  "name": "dsh-offline-plugin-installer",
  "version": "0.1.3",
  "description": "A loopback-only DeepSeek Harness Web plugin for validating and installing offline plugin tarballs into the active profile.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundles": "tsdown --config tsdown.config.ts",
    "build": "npm run clean && npm run build:types && npm run build:bundles",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/packaging/**' --exclude 'tests/snapshots/**'",
    "test:coverage": "vitest run --coverage --exclude 'tests/packaging/**' --exclude 'tests/snapshots/**'",
    "test:snapshot": "vitest run tests/snapshots",
    "test:built": "npm run build && vitest run tests/packaging",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run test:coverage && npm run test:snapshot && npm run test:built",
    "prepare": "npm run build",
    "pack:release": "npm run check && npm pack"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "offline",
    "plugin-installer"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/tar-stream": "^3.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^27.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tar-stream": "^3.1.7",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
