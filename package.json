{
  "name": "dsh-windows-desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Windows desktop shell for the official DeepSeek Harness Web profile.",
  "main": "dist/main/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:real-dsh": "pnpm run build && node scripts/real-dsh-smoke.mjs",
    "test:staged-runtime": "pnpm run build && node scripts/real-dsh-smoke.mjs --staged",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "verify:staged-runtime": "node scripts/verify-staged-runtime.mjs",
    "pack:dir": "pnpm run verify:staged-runtime && pnpm run build && electron-builder --dir",
    "pack:win": "pnpm run verify:staged-runtime && pnpm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "oxlint": "1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
